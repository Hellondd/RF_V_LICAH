# ================================
# RUSSIA V LICAH — Конфигурация
# ================================
# Скопируйте этот файл в .env и заполните своими данными
# НИКОГДА не добавляйте .env в Git!

# --- База данных ---
DATABASE_URL=postgresql://user:password@localhost:5432/russia_v_licah
# Для SQLite (учебный вариант):
# DATABASE_URL=sqlite:///./russia_v_licah.db

# --- Секретный ключ (придумайте любую длинную строку) ---
SECRET_KEY=замените_на_случайную_строку_минимум_32_символа

# --- JWT токены ---
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Сервер ---
HOST=0.0.0.0
PORT=8000
DEBUG=True

# --- Загрузка файлов ---
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# --- ИИ-помощник (опционально) ---
# ANTHROPIC_API_KEY=ваш_ключ_если_используете_Claude
# OPENAI_API_KEY=ваш_ключ_если_используете_OpenAI

# --- Frontend ---
FRONTEND_URL=http://localhost:5173

# --- Администратор по умолчанию ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=замените_на_надёжный_пароль
